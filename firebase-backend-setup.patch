--- /dev/null
+++ b/src/auth/ensureUserDoc.js
@@ -0,0 +1,31 @@
+// src/auth/ensureUserDoc.js
+//
+// Firebase Auth and the app's Firestore data are two separate systems —
+// creating an Auth account (email/password OR Google) does NOT create a
+// matching `users/{uid}` document. Everything else in the app (RequireAdmin's
+// role check, Profile.jsx, the account menu, the Firestore rules themselves)
+// assumes that doc exists with at least a `role` field.
+//
+// Call this once right after any successful sign-in or sign-up (email
+// signup, Google popup, Google redirect) so that doc always gets created —
+// exactly once, on first sign-in, and never overwritten afterwards. Safe to
+// call on every login too: it's a no-op once the doc exists, so it never
+// touches (and can never accidentally reset) a role that was later promoted
+// to "admin" from the Firebase Console.
+
+import { doc, getDoc, setDoc, serverTimestamp } from "firebase/firestore";
+import { db } from "../firebase/Firebase";
+
+export async function ensureUserDoc(user) {
+  if (!user) return;
+  const ref = doc(db, "users", user.uid);
+  const snap = await getDoc(ref);
+  if (snap.exists()) return; // never overwrite an existing doc/role here
+
+  await setDoc(ref, {
+    name: user.displayName || null,
+    email: user.email || null,
+    role: "student",
+    createdAt: serverTimestamp(),
+  });
+}
