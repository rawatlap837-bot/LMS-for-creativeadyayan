diff --git a/storage.rules b/storage.rules
new file mode 100644
index 0000000..5f91ded
--- /dev/null
+++ b/storage.rules
@@ -0,0 +1,30 @@
+rules_version = '2';
+service firebase.storage {
+  match /b/{bucket}/o {
+
+    // -----------------------------------------------------------------
+    // avatars/{userId} — profile photo, written from src/student/Profile.jsx.
+    // Any signed-in user can view avatars (they're shown in the topbar/
+    // account menu); only the owner can upload their own.
+    // -----------------------------------------------------------------
+    match /avatars/{userId} {
+      allow read: if request.auth != null;
+      allow write: if request.auth != null && request.auth.uid == userId &&
+        request.resource.size < 5 * 1024 * 1024 &&
+        request.resource.contentType.matches('image/.*');
+    }
+
+    // -----------------------------------------------------------------
+    // submissions/{userId}/{assignmentId}/{fileName} — assignment uploads
+    // from src/student/Assignments.jsx. Matches the 15MB cap (MAX_FILE_MB)
+    // already enforced client-side.
+    // -----------------------------------------------------------------
+    match /submissions/{userId}/{assignmentId}/{fileName} {
+      // any signed-in user can read (keeps this open for a future admin
+      // grading UI without needing custom claims wired up yet)
+      allow read: if request.auth != null;
+      allow write: if request.auth != null && request.auth.uid == userId &&
+        request.resource.size < 15 * 1024 * 1024;
+    }
+  }
+}
